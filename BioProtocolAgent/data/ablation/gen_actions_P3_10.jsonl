{"protocol_id": "Bio-protocol-3584", "actions": [{"action": "set up PCR reaction", "description": "Set up a PCR reaction using high-fidelity Phusion polymerase, GC buffer, and 10% glycerol."}, {"action": "optimize PCR conditions", "description": "Optimize PCR conditions by adding up to 10% DMSO, up to 4 mM MgCl2, or adjusting the annealing temperature as needed."}, {"action": "design forward primer", "description": "Design a forward primer with a 5′-CACC nucleotide tailing for directional cloning, ensuring it does not contain a stop codon."}, {"action": "design reverse primer", "description": "Design a reverse primer that complements the 3' end of the gene sequence, ensuring it does not contain a stop codon."}, {"action": "perform PCR amplification", "description": "Amplify the targeted TF or CoREG ORFs using the designed primers and optimized PCR conditions."}, {"action": "clone PCR product", "description": "Clone the amplified ORFs into either the pENTR/D-TOPO or pENTR/SD/D-TOPO vector."}, {"action": "transform bacteria", "description": "Transform competent E. coli cells with the ligation mixture and plate on kanamycin-containing agar plates."}, {"action": "incubate plates", "description": "Incubate the plates at 37°C until colonies are visible."}, {"action": "screen colonies by PCR", "description": "Screen kanamycin-resistant colonies for inserts of the correct size by colony PCR."}, {"action": "perform restriction digestion", "description": "Alternatively, perform restriction digestion of candidate plasmids to verify the correct orientation of inserts."}, {"action": "prepare sequencing reaction", "description": "Set up a Sanger sequencing reaction using single-read paired-end sequencing for clones shorter than 1200 bp."}, {"action": "design internal primers", "description": "Design internal primers for Sanger sequencing of clones longer than 1200 bp."}, {"action": "complete sequence confirmation", "description": "Complete the sequence confirmation of longer clones using the designed internal primers."}], "protocol_text": null}
